<?xml version="1.0" encoding="UTF-8"?>
<!--
  Project-scoped Maven settings, applied via .mvn/maven.config.
  They replace any user-level ~/.m2/settings.xml for this build, so corporate
  mirrors, proxies or profiles on a contributor's machine never leak in and
  everyone resolves dependencies from Maven Central the same way.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd"/>
